@article{zhang2026attnqat,
  author    = {Peiyuan Zhang and Matthew Noto and Wenxuan Tan and Chengquan Jiang and Will Lin and Wei Zhou and Hao Zhang},
  title     = {{Attn-QAT}: 4-Bit Attention with Quantization-Aware Training},
  journal   = {arXiv preprint arXiv:2603.00040},
  year      = {2026},
  url       = {https://arxiv.org/abs/2603.00040},
  note      = {First systematic study of 4-bit QAT for attention; demonstrates that the natural FP4 forward + high-precision Flash Attention backward recipe is unstable; identifies (1) matching low-precision recomputation in backward and (2) resolving FA's implicit precision assumptions as the two principles for stable FP4 attention.}
}

@article{qiu2025lowprecisionfails,
  author    = {Haiquan Qiu and Quanming Yao},
  title     = {Why Low-Precision Transformer Training Fails: An Analysis on Flash Attention},
  journal   = {arXiv preprint arXiv:2510.04212},
  year      = {2025},
  url       = {https://arxiv.org/abs/2510.04212},
  note      = {Mechanistic explanation of catastrophic loss explosion in low-precision flash attention training; identifies the joint effect of (a) emergence of similar low-rank representations in attention and (b) compounding biased rounding errors. ICLR 2026 poster.}
}

@article{zhang2026snapmla,
